# ─────────────────────────────────────────────────────────────
# KitchenwareBot environment (copy to .env, fill in, keep secret)
# In .NET, "__" (double underscore) maps to nested config keys.
# ─────────────────────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Production

# Database (SQL Server) — used by docker-compose
SA_PASSWORD=Your_Strong_Passw0rd!
ConnectionStrings__Default=Server=sqlserver;Database=KitchenwareBot;User Id=sa;Password=Your_Strong_Passw0rd!;TrustServerCertificate=True

# Redis
Redis__Connection=redis:6379
Redis__SessionTtlMinutes=30

# Telegram
Telegram__BotToken=123456:ABC-your-bot-token
Telegram__WebhookUrl=https://yourdomain.com/telegram/webhook
Telegram__WebhookSecretToken=some-random-secret-string
Telegram__BotUsername=your_bot_username
Telegram__ChannelId=-1001234567890
# Arrays use numeric path segments when supplied through environment variables.
Telegram__AdminIds__0=123456789
Telegram__AdminIds__1=987654321

# JWT (Phase 10 API only)
Jwt__SecretKey=change-me-to-a-long-random-secret-at-least-32-chars
Jwt__Issuer=KitchenwareBot
Jwt__Audience=KitchenwareBot
Jwt__ExpiryMinutes=60
